
#include "servo.h"
#include "Timer.h"
#include "button.h"
/**
 * main.c
 */
int main(void)
{
    timer_init();
	servo_init();



	button_init();
	int button;
	int direction = 1;
	while(1){
	    button = button_getButton();
	    if(button == 1){
	        servo_move((1 * direction));
	    }
	    else if(button == 2){
	        servo_move((5 * direction));
	    }
	    else if(button == 3){
	        direction = direction * -1;
	    }
	    else if(button == 4){
	        if(direction == 1){
	            TIMER1_TBMATCHR_R = 0x5500;
	        }
	        else if(direction == (-1)){
	            TIMER1_TBMATCHR_R = 0xBBFF;
	        }
	    }

	}

}
