
#include "servo.h"
#include "Timer.h"
#include "button.h"
#include "lcd.h"
/**
 * main.c
 */
int main(void)
{
    timer_init();
	servo_init();
	lcd_init();



	button_init();
	int button;
	int direction = 1;
	while(1){
	    button = button_getButton();
	    if(button == 1){
	        servo_move((1 * direction));
	        lcd_printf("Turned 1 degree\n\r");
	        timer_waitMillis(1000);
	        if(direction == 1){
	            lcd_printf("clockwise\n\r");
	        }
	        else if(direction == -1){
	            lcd_printf("anticlockwise\n\r");
	        }
	    }
	    else if(button == 2){
	        servo_move((5 * direction));
	        lcd_printf("Turned 5 degrees\n\r");
            timer_waitMillis(1000);

	                    if(direction == 1){
	                        lcd_printf("clockwise\r\n");
	                    }
	                    else if(direction == -1){
	                        lcd_printf("anticlockwise\r\n");
	                    }
	    }
	    else if(button == 3){
	        direction = direction * -1;
	        if(direction == 1){
	            lcd_printf("switched to clockwise");
	        }
	        else if(direction == -1){
	            lcd_printf("switched to anticlockwise");
	        }
	    }
	    else if(button == 4){
	        if(direction == -1){
	            TIMER1_TBMATCHR_R = 0x6500;
	            lcd_printf("turned to 180");
	        }
	        else if(direction == (1)){
	            TIMER1_TBMATCHR_R = 0xD6FF;
	            lcd_printf("turned to 0");
	        }
	    }
	    timer_waitMillis(500);

	}

}
