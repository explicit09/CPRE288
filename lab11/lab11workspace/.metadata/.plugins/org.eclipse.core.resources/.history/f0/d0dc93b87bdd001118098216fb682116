#include "Timer.h"
#include "servo.h"
#include <inc/tm4c123gh6pm.h>
void servo_init(void){
    SYSCTL_RCGCGPIO_R |= 0x02; // enables port b
    SYSCTL_RCGCTIMER_R |= 0x02; //enables timer clock

    GPIO_PORTB_DEN_R |= 0x20; //enables pbwire 5
    GPIO_PORTB_DIR_R |= 0x20; //sets wire 5 to output
    GPIO_PORTB_AFSEL_R &= 0xDF; //disables wire 5 afsel



    TIMER1_CTL_R &= 0xEFF; //disables timer1
        TIMER1_CFG_R |= 0x4; //sets 16 bit timer
        //TIMER1_CFG_R &= 0xC;
        TIMER1_TBMR_R = 0x06;
        TIMER1_TBMR_R |= 0x200;
        TIMER1_TBPR_R = 0x04;
        TIMER1_TBILR_R = 0xE200;
        //TIMER1_TBMATCH_R = 0x46500;
        TIMER1_CTL_R |= 0xD00;
}
int servo_move(void){
    TIMER1_TBPMR_R = 0x04;
    TIMER1_TBMATCHR_R = A380;
    timer_waitMillis(1000);

}
