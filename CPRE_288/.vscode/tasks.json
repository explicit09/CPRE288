{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mac Tiva: Build Lab8",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/tiva.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Mac Tiva: Check Tiva connection",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/tiva.py",
        "probe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Mac Tiva: Build and flash Lab8",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/tiva.py",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
